#!/usr/bin/env python3
"""mailbox-hook — drop-in for any runner: check inbox and print pending count.

Called by runner at agent_end / task_boundary. Returns JSON with pending count
and first message summary. Runner can then inject this into agent context.

Exit codes: 0 = inbox empty,1 = messages pending (summary on stdout)
"""

import json, sys
from pathlib import Path

ROOT = Path.home() / "Dropbox/logseq/pages/mi-docs/_mailbox"

def main(worker_id: str):
    inbox = ROOT / worker_id / "inbox"
    if not inbox.exists():
        json.dump({"pending": 0, "messages": []}, sys.stdout)
        sys.exit(0)

    files = [f for f in inbox.glob("*.json")
             if f.is_file() and not f.is_symlink()
             and not f.name.startswith(".sync-conflict")
             and not f.name.startswith(".tmp-")]

    if not files:
        json.dump({"pending": 0, "messages": []}, sys.stdout)
        sys.exit(0)

    summaries = []
    for f in sorted(files, key=lambda f: f.stat().st_mtime)[:5]:
        try:
            msg = json.loads(f.read_bytes())
            summaries.append({
                "from": msg.get("from","?"),
                "kind": msg.get("kind","?"),
                "subject": msg.get("subject","")[:80],
            })
        except: pass

    result = {"pending": len(files), "messages": summaries, "action": "run mailbox check"}
    json.dump(result, sys.stdout, ensure_ascii=False)
    sys.exit(1 if files else 0)

if __name__ == "__main__":
    worker_id = sys.argv[1] if len(sys.argv) > 1 else "unknown"
    main(worker_id)
